#!/bin/sh
#
# Pre-commit hook: runs frontend checks, formats staged PHP files with Pint, then runs Larastan.
#
# Install with:   composer hooks:install
# Skip once with: SKIP_HOOKS=1 git commit ...

set -e

cd "$(git rev-parse --show-toplevel)"

if [ -n "${SKIP_HOOKS:-}" ]; then
    echo "SKIP_HOOKS is set, skipping all pre-commit checks."
    exit 0
fi

echo "Running frontend formatting and lint checks..."
npm run check

staged_php="$(git diff --cached --name-only --no-renames --diff-filter=ACMR -- '*.php')"

if [ -z "$staged_php" ]; then
    echo "No staged PHP files, skipping Pint and Larastan."
    exit 0
fi

# Build the argument list from staged files that still exist on disk.
set --
old_ifs="$IFS"
IFS='
'
for file in $staged_php; do
    if [ -f "$file" ]; then
        set -- "$@" "$file"
    fi
done
IFS="$old_ifs"

if [ "$#" -gt 0 ]; then
    echo "Pint: formatting $# staged PHP file(s)..."
    vendor/bin/pint "$@"

    # Re-stage the formatted files so the commit includes the fixes.
    for file in "$@"; do
        git add -- "$file"
    done
fi

echo "Larastan: running static analysis..."
vendor/bin/phpstan analyse --no-progress
